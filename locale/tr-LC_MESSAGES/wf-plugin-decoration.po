#. (itstool) path: plugin/_short
msgid "Decoration"
msgstr "Dekorasyon"

#. (itstool) path: plugin/_long
msgid "Default decorations around XWayland windows."
msgstr "XWayland pencereleri çevresindeki varsayılan dekorasyonlar."

#. (itstool) path: option/_short
msgid "Font"
msgstr "Yazı tipi"

#. (itstool) path: option/_long
msgid "Sets the font to use for the title bars."
msgstr "Başlık çubuklarında kullanılacak yazı tipini ayarlar."

#. (itstool) path: option/_short
msgid "Font color"
msgstr "Yazı tipi rengi"

#. (itstool) path: option/_long
msgid "Sets the font color to use for the title bars."
msgstr "Başlık çubuklarında kullanılacak yazı tipi rengini ayarlar."

#. (itstool) path: option/_short
msgid "Title bar height"
msgstr "Başlık çubuğu yüksekliği"

#. (itstool) path: option/_long
msgid "Sets the height of the title bars in pixels."
msgstr "Başlık çubuklarının yüksekliğini piksel cinsinden ayarlar."

#. (itstool) path: option/_short
msgid "Border size"
msgstr "Kenarlık boyutu"

#. (itstool) path: option/_long
msgid "Sets the border size in pixels."
msgstr "Kenarlık boyutunu piksel cinsinden ayarlar."

#. (itstool) path: option/_short
msgid "Order of window buttons"
msgstr "Pencere düğmelerinin sırası"

#. (itstool) path: option/_long
msgid "Sets the order of the window buttons."
msgstr "Pencere düğmelerinin sırasını ayarlar."

#. (itstool) path: option/_short
msgid "Color when window is active"
msgstr "Pencere etkinken renk"

#. (itstool) path: option/_long
msgid "Sets the color when the window is active."
msgstr "Pencere etkinken kullanılacak rengi ayarlar."

#. (itstool) path: option/_short
msgid "Color when window is inactive"
msgstr "Pencere etkin değilken renk"

#. (itstool) path: option/_long
msgid "Sets the color when the window is inactive."
msgstr "Pencere etkin değilken kullanılacak rengi ayarlar."

#. (itstool) path: option/_short
msgid "Decoration disabled for specified window types"
msgstr "Belirtilen pencere türleri için dekorasyon devre dışı"

#. (itstool) path: option/_long
msgid "Disables window decoration for windows matching the specified criteria."
msgstr ""
"Belirtilen ölçütlerle eşleşen pencereler için pencere dekorasyonunu devre "
"dışı bırakır."

#. (itstool) path: option/_short
msgid "Force decorations for specified window types"
msgstr "Belirtilen pencere türleri için dekorasyonu zorla"

#. (itstool) path: option/_long
msgid ""
"Forces window decoration for windows matching the specified criteria, "
"overriding client decoration preference."
msgstr ""
"Belirtilen ölçütlerle eşleşen pencereler için pencere dekorasyonunu zorlar "
"ve istemcinin dekorasyon tercihini yok sayar."
