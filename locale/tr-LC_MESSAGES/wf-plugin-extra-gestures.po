#. (itstool) path: plugin/_short
msgid "Extra Touchscreen Gestures"
msgstr "Ek Dokunmatik Ekran Jestleri"

#. (itstool) path: plugin/_long
msgid "A plugin which provides several touchscreen gestures."
msgstr "Birkaç dokunmatik ekran jesti sağlayan bir eklenti."

#. (itstool) path: option/_short
msgid "Fingers to move"
msgstr "Hareket için parmaklar"

#. (itstool) path: option/_long
msgid ""
"Number of fingers to press and hold to start interactive move of the view."
msgstr ""
"Görünümün etkileşimli hareketini başlatmak için basılı tutulacak parmak "
"sayısı."

#. (itstool) path: option/_short
msgid "Start moving after"
msgstr "Şu kadar süre sonra hareketi başlat"

#. (itstool) path: option/_long
msgid ""
"Amount of time in milliseconds to hold fingers before starting interactive "
"move of the view."
msgstr ""
"Görünümün etkileşimli hareketi başlatılmadan önce parmakların milisaniye "
"cinsinden tutulacağı süre."

#. (itstool) path: option/_short
msgid "Tap to close"
msgstr "Kapatmak için dokun"

#. (itstool) path: option/_long
msgid ""
"Number of fingers to tap with to close a window. Set to very high(20) to "
"disable."
msgstr ""
"Bir pencereyi kapatmak için dokunulacak parmak sayısı. Devre dışı bırakmak "
"için çok yüksek bir değere (20) ayarlayın."
