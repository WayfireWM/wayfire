#. (itstool) path: plugin/_short
msgid "Output Switcher"
msgstr "Çıkış Değiştirici"

#. (itstool) path: plugin/_long
msgid "A plugin to change the focused output."
msgstr "Odaklanan çıkışı değiştirmek için bir eklenti."

#. (itstool) path: option/_short
msgid "Next output"
msgstr "Sonraki çıkış"

#. (itstool) path: option/_long
msgid "Moves focus to the next output with the specified activator."
msgstr "Odağı belirtilen etkinleştirici ile sonraki çıkışa taşır."

#. (itstool) path: option/_short
msgid "Next output with window"
msgstr "Pencere ile sonraki çıkış"

#. (itstool) path: option/_long
msgid ""
"Moves focus to the next output with the focused window with the specified "
"activator."
msgstr ""
"Odağı, odaklanan pencere ile birlikte belirtilen etkinleştirici ile sonraki "
"çıkışa taşır."

#. (itstool) path: option/_short
msgid "Previous output"
msgstr "Önceki çıkış"

#. (itstool) path: option/_long
msgid "Moves focus to the previous output with the specified activator."
msgstr "Odağı belirtilen etkinleştirici ile önceki çıkışa taşır."

#. (itstool) path: option/_short
msgid "Previous output with window"
msgstr "Pencere ile önceki çıkış"

#. (itstool) path: option/_long
msgid ""
"Moves focus to the previous output with the focused window with the "
"specified activator."
msgstr ""
"Odağı, odaklanan pencere ile birlikte belirtilen etkinleştirici ile önceki "
"çıkışa taşır."

#. (itstool) path: option/_short
msgid "Left output"
msgstr "Sol çıkış"

#. (itstool) path: option/_long
msgid "Moves focus to the output on the left."
msgstr "Odağı sol çıkışa taşır."

#. (itstool) path: option/_short
msgid "Right output"
msgstr "Sağ çıkış"

#. (itstool) path: option/_long
msgid "Moves focus to the output on the right."
msgstr "Odağı sağ çıkışa taşır."

#. (itstool) path: option/_short
msgid "Above output"
msgstr "Yukarıdaki çıkış"

#. (itstool) path: option/_long
msgid "Moves focus to the output above."
msgstr "Odağı yukarıdaki çıkışa taşır."

#. (itstool) path: option/_short
msgid "Below output"
msgstr "Aşağıdaki çıkış"

#. (itstool) path: option/_long
msgid "Moves focus to the output below."
msgstr "Odağı aşağıdaki çıkışa taşır."
