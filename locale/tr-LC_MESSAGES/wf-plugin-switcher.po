#. (itstool) path: plugin/_short
msgid "Switcher"
msgstr "Değiştirici"

#. (itstool) path: plugin/_long
msgid "A plugin to change active window with an animation."
msgstr "Etkin pencereyi animasyonla değiştiren bir eklenti."

#. (itstool) path: option/_short
msgid "Next view"
msgstr "Sonraki görünüm"

#. (itstool) path: option/_long
msgid "Switches to the next view with the specified key."
msgstr "Belirtilen tuşla sonraki görünüme geçer."

#. (itstool) path: option/_short
msgid "Previous view"
msgstr "Önceki görünüm"

#. (itstool) path: option/_long
msgid "Switches to the previous view with the specified key."
msgstr "Belirtilen tuşla önceki görünüme geçer."

#. (itstool) path: option/_short
msgid "Duration"
msgstr "Süre"

#. (itstool) path: option/_long
msgid "Sets the duration of the animation in milliseconds."
msgstr "Animasyonun süresini milisaniye cinsinden ayarlar."

#. (itstool) path: option/_short
msgid "Thumbnail size"
msgstr "Küçük resim boyutu"

#. (itstool) path: option/_long
msgid "Sets the thumbnail size."
msgstr "Küçük resim boyutunu ayarlar."

#. (itstool) path: option/_short
msgid "Thumbnail rotation"
msgstr "Küçük resim döndürme açısı"

#. (itstool) path: option/_long
msgid "Sets the thumbnail rotation in degrees."
msgstr "Küçük resim döndürme açısını derece cinsinden ayarlar."
