#. (itstool) path: plugin/_short
msgid "WM Actions"
msgstr "Pencere Yönetimi Eylemleri"

#. (itstool) path: plugin/_long
msgid "A plugin which provides various window management functionalities."
msgstr "Çeşitli pencere yönetimi işlevleri sağlayan bir eklenti."

#. (itstool) path: option/_short
msgid "Toggle Always on Top"
msgstr "Her Zaman Üstte Aç/Kapat"

#. (itstool) path: option/_long
msgid "Toggle the always-on-top state of a view."
msgstr "Bir pencerenin her zaman üstte olma durumunu açar/kapatır."

#. (itstool) path: option/_short
msgid "Toggle Fullscreen"
msgstr "Tam Ekranı Aç/Kapat"

#. (itstool) path: option/_long
msgid "Toggle the fullscreen state of a view."
msgstr "Bir pencerenin tam ekran durumunu açar/kapatır."

#. (itstool) path: option/_short
msgid "Toggle Sticky"
msgstr "Yapışkan Aç/Kapat"

#. (itstool) path: option/_long
msgid "Toggle the sticky state of a view."
msgstr "Bir pencerenin yapışkan durumunu açar/kapatır."

#. (itstool) path: option/_short
msgid "Toggle Maximize"
msgstr "Büyütmeyi Aç/Kapat"

#. (itstool) path: option/_long
msgid "Toggle the maximize state of the active view."
msgstr "Etkin pencerenin büyütülmüş durumunu açar/kapatır."

#. (itstool) path: option/_short
msgid "Minimize View"
msgstr "Pencereyi Küçült"

#. (itstool) path: option/_long
msgid "Minimize the active view."
msgstr "Etkin pencereyi küçültür."

#. (itstool) path: option/_short
msgid "Toggle Show Desktop"
msgstr "Masaüstünü Göstermeyi Aç/Kapat"

#. (itstool) path: option/_long
msgid "Show the desktop."
msgstr "Masaüstünü gösterir."

#. (itstool) path: option/_short
msgid "Send to back"
msgstr "En Arkaya Gönder"

#. (itstool) path: option/_long
msgid "Send the active view to behind all other views."
msgstr "Etkin pencereyi diğer tüm pencerelerin arkasına gönderir."
