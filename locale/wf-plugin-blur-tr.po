#. (itstool) path: plugin/_short
msgid "Blur"
msgstr "Bulanıklaştırma"

#. (itstool) path: plugin/_long
msgid "A plugin to blur windows."
msgstr "Pencereleri bulanıklaştırmak için bir eklenti."

#. (itstool) path: option/_short
msgid "Blur by default"
msgstr "Varsayılan olarak bulanıklaştır"

#. (itstool) path: option/_long
msgid "Criteria for which apps to be blurred when they are opened"
msgstr "Açıldıklarında hangi uygulamaların bulanıklaştırılacağını belirleyen ölçütler"

#. (itstool) path: option/_short
msgid "Toggle"
msgstr "Aç/Kapat"

#. (itstool) path: option/_long
msgid "Sets the shortcut to toggle blurring for a specific window."
msgstr "Belirli bir pencere için bulanıklaştırmayı açıp kapatma kısayolunu ayarlar."

#. (itstool) path: option/_short
msgid "Method"
msgstr "Yöntem"

#. (itstool) path: option/_long
msgid "Chooses a blur algorithm."
msgstr "Bir bulanıklaştırma algoritması seçer."

#. (itstool) path: desc/_name
msgid "Box"
msgstr "Kutu"

#. (itstool) path: desc/_name
msgid "Gaussian"
msgstr "Gauss"

#. (itstool) path: desc/_name
msgid "Kawase"
msgstr "Kawase"

#. (itstool) path: desc/_name
