#. (itstool) path: plugin/_short
#. (itstool) path: entry/_short
msgid "Command"
msgstr "Komut"

#. (itstool) path: plugin/_long
msgid ""
"A plugin to bind key combo (key, button, touch) to execute shell commands."
msgstr ""
"Kabuk komutlarını çalıştırmak için tuş kombinasyonlarını (tuş, düğme, "
"dokunuş) bağlamaya yarayan bir eklenti."

#. (itstool) path: option/_short
#. (itstool) path: option/_long
msgid "Regular bindings"
msgstr "Normal bağlamalar"

#. (itstool) path: entry/_long
msgid "Sets the command to execute."
msgstr "Çalıştırılacak komutu ayarlar."

#. (itstool) path: entry/_short
msgid "Binding"
msgstr "Bağlama"

#. (itstool) path: entry/_long
msgid "Sets the triggering activator binding."
msgstr "Etkinleştirmeyi tetikleyen bağlamayı ayarlar."

#. (itstool) path: option/_short
msgid "Repeatable bindings"
msgstr "Tekrarlanabilir bağlamalar"

#. (itstool) path: option/_long
msgid ""
"Bindings which repeat their command if their key or button is held pressed."
msgstr ""
"Tuşu veya düğmesi basılı tutulduğunda komutunu tekrarlayan bağlamalar."

#. (itstool) path: option/_short
msgid "Always bindings"
msgstr "Her zaman kullanılabilir bağlamalar"

#. (itstool) path: option/_long
msgid ""
"Sets the bindings which are always available, even when screen is locked."
msgstr ""
"Ekran kilitliyken bile her zaman kullanılabilir olan bağlamaları ayarlar."

#. (itstool) path: option/_short
msgid "Release bindings"
msgstr "Bırakma bağlamaları"

#. (itstool) path: option/_long
msgid "Sets the bindings which activate on release"
msgstr "Bırakıldığında etkinleşen bağlamaları ayarlar"
