#. (itstool) path: plugin/_short
msgid "Grid"
msgstr "Izgara"

#. (itstool) path: plugin/_long
msgid "A plugin to position the windows in certain regions of the output."
msgstr "Pencereleri ekranın belirli bölgelerine konumlandıran bir eklenti."

#. (itstool) path: option/_short
msgid "Duration"
msgstr "Süre"

#. (itstool) path: option/_long
msgid "Sets the duration of the animation in milliseconds."
msgstr "Animasyonun süresini milisaniye cinsinden ayarlar."

#. (itstool) path: option/_short
msgid "Type"
msgstr "Tür"

#. (itstool) path: option/_long
msgid "Sets the type of the animation."
msgstr "Animasyonun türünü ayarlar."

#. (itstool) path: desc/_name
msgid "None"
msgstr "Yok"

#. (itstool) path: desc/_name
msgid "Crossfade"
msgstr "Çapraz geçiş"

#. (itstool) path: desc/_name
msgid "Wobbly"
msgstr "Titreyen"

#. (itstool) path: option/_short
msgid "Bottom left"
msgstr "Sol alt"

#. (itstool) path: option/_long
msgid ""
"Positions the window in the bottom left corner of the screen with the "
"specified activator. The window takes 1/4 of the screen."
msgstr ""
"Pencereyi belirtilen etkinleştirici ile ekranın sol alt köşesine "
"konumlandırır. Pencere ekranın 1/4'ünü kaplar."

#. (itstool) path: option/_short
msgid "Bottom"
msgstr "Alt"

#. (itstool) path: option/_long
msgid ""
"Positions the window in the bottom edge of the screen with the specified "
"activator. The window takes half of the screen."
msgstr ""
"Pencereyi belirtilen etkinleştirici ile ekranın alt kenarına konumlandırır. "
"Pencere ekranın yarısını kaplar."

#. (itstool) path: option/_short
msgid "Bottom right"
msgstr "Sağ alt"

#. (itstool) path: option/_long
msgid ""
"Positions the window in the bottom right corner of the screen with the "
"specified activator. The window takes 1/4 of the screen."
msgstr ""
"Pencereyi belirtilen etkinleştirici ile ekranın sağ alt köşesine "
"konumlandırır. Pencere ekranın 1/4'ünü kaplar."

#. (itstool) path: option/_short
msgid "Left"
msgstr "Sol"

#. (itstool) path: option/_long
msgid ""
"Positions the window in the left edge of the screen with the specified "
"activator. The window takes half of the screen."
msgstr ""
"Pencereyi belirtilen etkinleştirici ile ekranın sol kenarına konumlandırır. "
"Pencere ekranın yarısını kaplar."

#. (itstool) path: option/_short
msgid "Center"
msgstr "Orta"

#. (itstool) path: option/_long
msgid ""
"Positions the window in the center of the screen with the specified "
"activator. The window is maximized."
msgstr ""
"Pencereyi belirtilen etkinleştirici ile ekranın ortasına konumlandırır. "
"Pencere büyütülür."

#. (itstool) path: option/_short
msgid "Right"
msgstr "Sağ"

#. (itstool) path: option/_long
msgid ""
"Positions the window in the right edge of the screen with the specified "
"activator. The window takes half of the screen."
msgstr ""
"Pencereyi belirtilen etkinleştirici ile ekranın sağ kenarına konumlandırır. "
"Pencere ekranın yarısını kaplar."

#. (itstool) path: option/_short
msgid "Top left"
msgstr "Sol üst"

#. (itstool) path: option/_long
msgid ""
"Positions the window in the top left corner of the screen with the specified "
"activator. The window takes 1/4 of the screen."
msgstr ""
"Pencereyi belirtilen etkinleştirici ile ekranın sol üst köşesine "
"konumlandırır. Pencere ekranın 1/4'ünü kaplar."

#. (itstool) path: option/_short
msgid "Top"
msgstr "Üst"

#. (itstool) path: option/_long
msgid ""
"Positions the window in the top edge of the screen with the specified "
"activator. The window takes half of the screen."
msgstr ""
"Pencereyi belirtilen etkinleştirici ile ekranın üst kenarına konumlandırır. "
"Pencere ekranın yarısını kaplar."

#. (itstool) path: option/_short
msgid "Top right"
msgstr "Sağ üst"

#. (itstool) path: option/_long
msgid ""
"Positions the window in the top right corner of the screen with the "
"specified activator. The window takes 1/4 of the screen."
msgstr ""
"Pencereyi belirtilen etkinleştirici ile ekranın sağ üst köşesine "
"konumlandırır. Pencere ekranın 1/4'ünü kaplar."

#. (itstool) path: option/_short
msgid "Restore"
msgstr "Geri yükle"

#. (itstool) path: option/_long
msgid ""
"Restores the window to its original size and position with the specified "
"activator."
msgstr ""
"Pencereyi belirtilen etkinleştirici ile özgün boyutuna ve konumuna geri "
"yükler."
