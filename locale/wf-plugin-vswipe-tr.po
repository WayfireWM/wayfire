#. (itstool) path: plugin/_short
msgid "Viewport Swipe"
msgstr "Görünüm alanı kaydırma"

#. (itstool) path: plugin/_long
msgid "A plugin to swipe workspaces in a grid."
msgstr "Çalışma alanlarını bir ızgarada kaydırmak için bir eklenti."

#. (itstool) path: option/_short
msgid "Enable horizontal"
msgstr "Yatayı etkinleştir"

#. (itstool) path: option/_long
msgid "Enables or disables horizontal swiping."
msgstr "Yatay kaydırmayı etkinleştirir veya devre dışı bırakır."

#. (itstool) path: option/_short
msgid "Enable vertical"
msgstr "Dikeyi etkinleştir"

#. (itstool) path: option/_long
msgid "Enables or disables vertical swiping."
msgstr "Dikey kaydırmayı etkinleştirir veya devre dışı bırakır."

#. (itstool) path: option/_short
msgid "Enable free movement"
msgstr "Serbest hareketi etkinleştir"

#. (itstool) path: option/_long
msgid ""
"Enables or disables moving diagonally and more than one workspace at a time."
msgstr ""
"Çapraz hareket etmeyi ve aynı anda birden fazla çalışma alanı geçmeyi "
"etkinleştirir veya devre dışı bırakır."

#. (itstool) path: option/_short
msgid "Enable smooth transition"
msgstr "Pürüzsüz geçişi etkinleştir"

#. (itstool) path: option/_long
msgid "Enables or disables smooth transition."
msgstr "Pürüzsüz geçişi etkinleştirir veya devre dışı bırakır."

#. (itstool) path: option/_short
msgid "Duration"
msgstr "Süre"

#. (itstool) path: option/_long
msgid "Sets the duration of the animation in milliseconds."
msgstr "Animasyonun süresini milisaniye cinsinden ayarlar."

#. (itstool) path: option/_short
msgid "Background color"
msgstr "Arka plan rengi"

#. (itstool) path: option/_long
msgid "Sets the background color."
msgstr "Arka plan rengini ayarlar."

#. (itstool) path: option/_short
msgid "Number of fingers"
msgstr "Parmak sayısı"

#. (itstool) path: option/_long
msgid "Specifies the number of fingers to swipe."
msgstr "Kaydırma için parmak sayısını belirtir."

#. (itstool) path: option/_short
msgid "Gap"
msgstr "Boşluk"

#. (itstool) path: option/_long
msgid "Changes the gap in pixels."
msgstr "Boşluğu piksel cinsinden değiştirir."

#. (itstool) path: option/_short
msgid "threshold"
msgstr "eşik"

#. (itstool) path: option/_long
msgid "Sets the threshold."
msgstr "Eşiği ayarlar."

#. (itstool) path: option/_short
msgid "Delta threshold"
msgstr "Delta eşiği"

#. (itstool) path: option/_long
msgid "Sets the delta threshold."
msgstr "Delta eşiğini ayarlar."

#. (itstool) path: option/_short
msgid "Speed factor"
msgstr "Hız çarpanı"

#. (itstool) path: option/_long
msgid "Sets the speed factor."
msgstr "Hız çarpanını ayarlar."

#. (itstool) path: option/_short
msgid "Speed cap"
msgstr "Hız üst sınırı"

#. (itstool) path: option/_long
msgid "Sets the speed cap."
msgstr "Hız üst sınırını ayarlar."
