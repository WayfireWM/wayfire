#. (itstool) path: plugin/_short
msgid "Zoom"
msgstr "Yakınlaştırma"

#. (itstool) path: plugin/_long
msgid "A plugin to zoom in the desktop with the mouse."
msgstr "Masaüstünü fare ile yakınlaştırmak için bir eklenti."

#. (itstool) path: option/_short
msgid "Zoom in the desktop by scrolling with modifier"
msgstr "Masaüstünü değiştirici tuş ile kaydırarak yakınlaştır"

#. (itstool) path: option/_long
msgid "Scrolls with the specified modifier to zoom in and out."
msgstr "Belirtilen değiştirici tuş ile kaydırma, yakınlaştırır ve uzaklaştırır."

#. (itstool) path: option/_short
msgid "Speed"
msgstr "Hız"

#. (itstool) path: option/_long
msgid "Sets the speed factor for zooming."
msgstr "Yakınlaştırma için hız çarpanını ayarlar."

#. (itstool) path: option/_short
msgid "Smoothing duration"
msgstr "Yumuşatma süresi"

#. (itstool) path: option/_long
msgid "Sets the smoothing duration in milliseconds."
msgstr "Yumuşatma süresini milisaniye cinsinden ayarlar."

#. (itstool) path: option/_short
msgid "Interpolation method"
msgstr "İnterpolasyon yöntemi"

#. (itstool) path: option/_long
msgid "Sets the pixel interpolation method to use."
msgstr "Kullanılacak piksel interpolasyon yöntemini ayarlar."

#. (itstool) path: desc/_name
msgid "Linear"
msgstr "Doğrusal"

#. (itstool) path: desc/_name
msgid "Nearest"
msgstr "En yakın"
