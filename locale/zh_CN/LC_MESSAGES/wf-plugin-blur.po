#. (itstool) path: plugin/_short
msgid "Blur"
msgstr "模糊"

#. (itstool) path: plugin/_long
msgid "A plugin to blur windows."
msgstr "用于模糊窗口的插件。"

#. (itstool) path: option/_short
msgid "Blur by default"
msgstr "默认模糊"

#. (itstool) path: option/_long
msgid "Criteria for which apps to be blurred when they are opened"
msgstr "指定应用打开时默认应用模糊的条件。"

#. (itstool) path: option/_short
msgid "Toggle"
msgstr "切换"

#. (itstool) path: option/_long
msgid "Sets the shortcut to toggle blurring for a specific window."
msgstr "设置切换特定窗口模糊效果的快捷键。"

#. (itstool) path: option/_short
msgid "Method"
msgstr "方法"

#. (itstool) path: option/_long
msgid "Chooses a blur algorithm."
msgstr "选择模糊算法。"

#. (itstool) path: desc/_name
msgid "Box"
msgstr "盒式"

#. (itstool) path: desc/_name
msgid "Gaussian"
msgstr "高斯"

#. (itstool) path: desc/_name
msgid "Kawase"
msgstr "Kawase"

#. (itstool) path: desc/_name
msgid "Bokeh"
msgstr "散景"

#. (itstool) path: option/_short
msgid "Blur saturation"
msgstr "模糊饱和度"

#. (itstool) path: option/_long
msgid "Sets the saturation of the blurred content."
msgstr "设置被模糊内容的饱和度。"

#. (itstool) path: option/_short
msgid "Box offset"
msgstr "盒式偏移"

#. (itstool) path: option/_long
msgid "Sets the offset value for the box method."
msgstr "设置盒式方法的偏移值。"

#. (itstool) path: option/_short
msgid "Box degrade"
msgstr "盒式衰减"

#. (itstool) path: option/_long
msgid "Sets the degrade value for the box method."
msgstr "设置盒式方法的衰减值。"

#. (itstool) path: option/_short
msgid "Box iterations"
msgstr "盒式迭代次数"

#. (itstool) path: option/_long
msgid "Sets the iterations for the box method."
msgstr "设置盒式方法的迭代次数。"

#. (itstool) path: option/_short
msgid "Gaussian offset"
msgstr "高斯偏移"

#. (itstool) path: option/_long
msgid "Sets the offset value for the gaussian method."
msgstr "设置高斯方法的偏移值。"

#. (itstool) path: option/_short
msgid "Gaussian degrade"
msgstr "高斯衰减"

#. (itstool) path: option/_long
msgid "Sets the degrade value for the gaussian method."
msgstr "设置高斯方法的衰减值。"

#. (itstool) path: option/_short
msgid "Gaussian iterations"
msgstr "高斯迭代次数"

#. (itstool) path: option/_long
msgid "Sets the iterations for the gaussian method."
msgstr "设置高斯方法的迭代次数。"

#. (itstool) path: option/_short
msgid "Kawase offset"
msgstr "Kawase 偏移"

#. (itstool) path: option/_long
msgid "Sets the offset value for the kawase method."
msgstr "设置 Kawase 方法的偏移值。"

#. (itstool) path: option/_short
msgid "Kawase degrade"
msgstr "Kawase 衰减"

#. (itstool) path: option/_long
msgid "Sets the degrade value for the kawase method."
msgstr "设置 Kawase 方法的衰减值。"

#. (itstool) path: option/_short
msgid "Kawase iterations"
msgstr "Kawase 迭代次数"

#. (itstool) path: option/_long
msgid "Sets the iterations for the kawase method."
msgstr "设置 Kawase 方法的迭代次数。"

#. (itstool) path: option/_short
msgid "Bokeh offset"
msgstr "散景偏移"

#. (itstool) path: option/_long
msgid "Sets the offset value for the bokeh method."
msgstr "设置散景方法的偏移值。"

#. (itstool) path: option/_short
msgid "Bokeh degrade"
msgstr "散景衰减"

#. (itstool) path: option/_long
msgid "Sets the degrade value for the bokeh method."
msgstr "设置散景方法的衰减值。"

#. (itstool) path: option/_short
msgid "Bokeh iterations"
msgstr "散景迭代次数"

#. (itstool) path: option/_long
msgid "Sets the iterations for the bokeh method."
msgstr "设置散景方法的迭代次数。"
