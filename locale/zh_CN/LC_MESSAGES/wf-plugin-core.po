#. (itstool) path: plugin/_short
msgid "Core"
msgstr "核心"

#. (itstool) path: plugin/_long
msgid "General options."
msgstr "常规选项。"

#. (itstool) path: option/_short
msgid "Plugins"
msgstr "插件"

#. (itstool) path: option/_long
msgid "Loads the specified plugins, space-separated list."
msgstr "加载指定的插件，列表以空格分隔。"

#. (itstool) path: option/_short
msgid "Close view"
msgstr "关闭窗口"

#. (itstool) path: option/_long
msgid "Closes the currently focused window with the specified key."
msgstr "使用指定按键关闭当前聚焦的窗口。"

#. (itstool) path: option/_short
msgid "Horizontal virtual size"
msgstr "水平虚拟尺寸"

#. (itstool) path: option/_long
msgid ""
"Sets the number of horizontal workspaces. Currently, cannot be changed at "
"runtime."
msgstr "设置水平方向的工作区数量。目前无法在运行时更改。"

#. (itstool) path: option/_short
msgid "Vertical virtual size"
msgstr "垂直虚拟尺寸"

#. (itstool) path: option/_long
msgid ""
"Sets the number of vertical workspaces. Currently, cannot be changed at "
"runtime."
msgstr "设置垂直方向的工作区数量。目前无法在运行时更改。"

#. (itstool) path: option/_short
msgid "Background color"
msgstr "背景颜色"

#. (itstool) path: option/_long
msgid ""
"Sets the background color of workspaces. Visible when nothing is drawing the "
"background."
msgstr "设置工作区的背景颜色。当没有其他内容绘制背景时可见。"

#. (itstool) path: option/_short
msgid "Preferred decoration mode"
msgstr "首选装饰模式"

#. (itstool) path: option/_long
msgid ""
"Sets the preferred window decoration mode. Possible values are `client` and "
"`server`. `client` allows the client to draw its own decorations."
msgstr "设置首选的窗口装饰模式。可选值为 `client` 和 `server`。`client` 允许客户端自行绘制装饰。"

#. (itstool) path: desc/_name
msgid "Client"
msgstr "客户端"

#. (itstool) path: desc/_name
msgid "Server"
msgstr "服务端"

#. (itstool) path: option/_short
msgid "XWayland"
msgstr "XWayland"

#. (itstool) path: option/_long
msgid ""
"Enables or disables XWayland support, which allows X11 applications to be "
"used."
msgstr "启用或禁用 XWayland 支持，以便使用 X11 应用程序。"

#. (itstool) path: desc/_name
msgid "Enable"
msgstr "启用"

#. (itstool) path: desc/_name
msgid "Disable"
msgstr "禁用"

#. (itstool) path: desc/_name
msgid "Start when client connects"
msgstr "客户端连接时启动"

#. (itstool) path: option/_short
msgid "XWayland startup script"
msgstr "XWayland 启动脚本"

#. (itstool) path: option/_long
msgid ""
"A script to execute when the XWayland server starts. This script is executed "
"in a POSIX shell (/bin/sh)."
msgstr "XWayland 服务器启动时执行的脚本。该脚本在 POSIX Shell（/bin/sh）中执行。"

#. (itstool) path: option/_short
msgid "Maximum render time"
msgstr "最大渲染时间"

#. (itstool) path: option/_long
msgid ""
"Sets the compositor render delay in milliseconds, which allows applications "
"to render with low latency."
msgstr "设置合成器的渲染延迟（毫秒），使应用能够以低延迟渲染。"

#. (itstool) path: option/_short
msgid "Timeout for transactions"
msgstr "事务超时时间"

#. (itstool) path: option/_long
msgid ""
"Maximum time in milliseconds to wait for clients to respond to compositor "
"requests."
msgstr "等待客户端响应合成器请求的最长时间（毫秒）。"

#. (itstool) path: option/_short
msgid "Focus on click if keyboard modifiers are pressed"
msgstr "按下键盘修饰键时点击聚焦"

#. (itstool) path: option/_long
msgid ""
"Allow focusing the clicked view even if keyboard modifiers are pressed. "
"Without this option, click-to-focus only works if no modifiers are pressed."
msgstr "允许在按下键盘修饰键时仍聚焦被点击的窗口。未启用此选项时，点击聚焦仅在未按下修饰键时生效。"

#. (itstool) path: option/_short
msgid "Mouse buttons to focus views"
msgstr "用于聚焦窗口的鼠标按钮"

#. (itstool) path: option/_long
msgid ""
"Clicking on a view with any of the mouse buttons of these will focus it."
msgstr "使用这些鼠标按钮中的任意一个点击窗口即可聚焦它。"

#. (itstool) path: option/_short
msgid "Pass through buttons to client"
msgstr "将按钮事件传递给客户端"

#. (itstool) path: option/_long
msgid ""
"Whether to pass buttons through to the client when switching the focus via "
"clicking"
msgstr "通过点击切换焦点时，是否将按钮事件传递给客户端。"

#. (itstool) path: option/_short
msgid "Wayfire Shutdown"
msgstr "关闭 Wayfire"

#. (itstool) path: option/_long
msgid "Calls the shutdown routines for wayfire."
msgstr "调用 Wayfire 的关闭例程。"
