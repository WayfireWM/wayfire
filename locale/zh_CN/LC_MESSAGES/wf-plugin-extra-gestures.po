#. (itstool) path: plugin/_short
msgid "Extra Touchscreen Gestures"
msgstr "额外触摸屏手势"

#. (itstool) path: plugin/_long
msgid "A plugin which provides several touchscreen gestures."
msgstr "提供多种触摸屏手势的插件。"

#. (itstool) path: option/_short
msgid "Fingers to move"
msgstr "移动所需手指数"

#. (itstool) path: option/_long
msgid ""
"Number of fingers to press and hold to start interactive move of the view."
msgstr "按住以开始交互式移动窗口所需的手指数。"

#. (itstool) path: option/_short
msgid "Start moving after"
msgstr "开始移动延迟"

#. (itstool) path: option/_long
msgid ""
"Amount of time in milliseconds to hold fingers before starting interactive "
"move of the view."
msgstr "开始交互式移动窗口前需要按住手指的时间（毫秒）。"

#. (itstool) path: option/_short
msgid "Tap to close"
msgstr "轻触关闭"

#. (itstool) path: option/_long
msgid ""
"Number of fingers to tap with to close a window. Set to very high(20) to "
"disable."
msgstr "轻触关闭窗口所需的手指数。设置为很大值（20）可禁用。"
