#. (itstool) path: plugin/_short
msgid "Fast Switcher"
msgstr "快速切换器"

#. (itstool) path: plugin/_long
msgid "A plugin to switch active window."
msgstr "切换活动窗口的插件。"

#. (itstool) path: option/_short
msgid "Next view"
msgstr "下一个窗口"

#. (itstool) path: option/_long
msgid ""
"Activates fast switcher with the specified key, moving to the next view."
msgstr "使用指定按键激活快速切换器并切换到下一个窗口。"

#. (itstool) path: option/_short
msgid "Previous view"
msgstr "上一个窗口"

#. (itstool) path: option/_long
msgid ""
"Activates fast switcher with the specified key, moving to the previous view."
msgstr "使用指定按键激活快速切换器并切换到上一个窗口。"

#. (itstool) path: option/_short
msgid "Inactive Opacity"
msgstr "非活动窗口不透明度"

#. (itstool) path: option/_long
msgid "Set the opacity value of the inactive windows."
msgstr "设置非活动窗口的不透明度。"
