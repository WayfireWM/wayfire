#. (itstool) path: plugin/_short
msgid "Grid"
msgstr "网格"

#. (itstool) path: plugin/_long
msgid "A plugin to position the windows in certain regions of the output."
msgstr "将窗口定位到输出特定区域的插件。"

#. (itstool) path: option/_short
msgid "Duration"
msgstr "持续时间"

#. (itstool) path: option/_long
msgid "Sets the duration of the animation in milliseconds."
msgstr "设置动画持续时间（毫秒）。"

#. (itstool) path: option/_short
msgid "Type"
msgstr "类型"

#. (itstool) path: option/_long
msgid "Sets the type of the animation."
msgstr "设置动画类型。"

#. (itstool) path: desc/_name
msgid "None"
msgstr "无"

#. (itstool) path: desc/_name
msgid "Crossfade"
msgstr "交叉淡化"

#. (itstool) path: desc/_name
msgid "Wobbly"
msgstr "摇晃"

#. (itstool) path: option/_short
msgid "Bottom left"
msgstr "左下"

#. (itstool) path: option/_long
msgid ""
"Positions the window in the bottom left corner of the screen with the "
"specified activator. The window takes 1/4 of the screen."
msgstr "使用指定激活器将窗口定位到屏幕左下角。窗口占据屏幕的 1/4。"

#. (itstool) path: option/_short
msgid "Bottom"
msgstr "底部"

#. (itstool) path: option/_long
msgid ""
"Positions the window in the bottom edge of the screen with the specified "
"activator. The window takes half of the screen."
msgstr "使用指定激活器将窗口定位到屏幕底边。窗口占据屏幕的一半。"

#. (itstool) path: option/_short
msgid "Bottom right"
msgstr "右下"

#. (itstool) path: option/_long
msgid ""
"Positions the window in the bottom right corner of the screen with the "
"specified activator. The window takes 1/4 of the screen."
msgstr "使用指定激活器将窗口定位到屏幕右下角。窗口占据屏幕的 1/4。"

#. (itstool) path: option/_short
msgid "Left"
msgstr "左侧"

#. (itstool) path: option/_long
msgid ""
"Positions the window in the left edge of the screen with the specified "
"activator. The window takes half of the screen."
msgstr "使用指定激活器将窗口定位到屏幕左侧。窗口占据屏幕的一半。"

#. (itstool) path: option/_short
msgid "Center"
msgstr "居中"

#. (itstool) path: option/_long
msgid ""
"Positions the window in the center of the screen with the specified "
"activator. The window is maximized."
msgstr "使用指定激活器将窗口定位到屏幕中央。窗口将最大化。"

#. (itstool) path: option/_short
msgid "Right"
msgstr "右侧"

#. (itstool) path: option/_long
msgid ""
"Positions the window in the right edge of the screen with the specified "
"activator. The window takes half of the screen."
msgstr "使用指定激活器将窗口定位到屏幕右侧。窗口占据屏幕的一半。"

#. (itstool) path: option/_short
msgid "Top left"
msgstr "左上"

#. (itstool) path: option/_long
msgid ""
"Positions the window in the top left corner of the screen with the specified "
"activator. The window takes 1/4 of the screen."
msgstr "使用指定激活器将窗口定位到屏幕左上角。窗口占据屏幕的 1/4。"

#. (itstool) path: option/_short
msgid "Top"
msgstr "顶部"

#. (itstool) path: option/_long
msgid ""
"Positions the window in the top edge of the screen with the specified "
"activator. The window takes half of the screen."
msgstr "使用指定激活器将窗口定位到屏幕顶边。窗口占据屏幕的一半。"

#. (itstool) path: option/_short
msgid "Top right"
msgstr "右上"

#. (itstool) path: option/_long
msgid ""
"Positions the window in the top right corner of the screen with the "
"specified activator. The window takes 1/4 of the screen."
msgstr "使用指定激活器将窗口定位到屏幕右上角。窗口占据屏幕的 1/4。"

#. (itstool) path: option/_short
msgid "Restore"
msgstr "恢复"

#. (itstool) path: option/_long
msgid ""
"Restores the window to its original size and position with the specified "
"activator."
msgstr "使用指定激活器将窗口恢复到原始大小和位置。"
