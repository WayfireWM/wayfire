#. (itstool) path: plugin/_short
msgid "Scale Title Filter"
msgstr "窗口概览标题过滤"

#. (itstool) path: plugin/_long
msgid "Filter the views shown by scale by typing."
msgstr "通过输入来过滤窗口概览中显示的窗口。"

#. (itstool) path: option/_short
msgid "Case sensitive"
msgstr "区分大小写"

#. (itstool) path: option/_long
msgid "Match titles in a case sensitive way."
msgstr "以区分大小写的方式匹配标题。"

#. (itstool) path: option/_short
msgid "Share filter among outputs"
msgstr "在输出之间共享过滤器"

#. (itstool) path: option/_long
msgid ""
"Whether the active filter is shared among all outputs. Set to false to "
"filter independently on each output."
msgstr "是否在所有输出之间共享当前过滤器。设为 false 可在每个输出上独立过滤。"

#. (itstool) path: option/_short
msgid "Show overlay"
msgstr "显示叠加层"

#. (itstool) path: option/_long
msgid "Whether the current filter value is shown as an overlay."
msgstr "是否将当前过滤值显示为叠加层。"

#. (itstool) path: option/_short
msgid "Text font size"
msgstr "文字字体大小"

#. (itstool) path: option/_long
msgid "Size of the text used in the overlay."
msgstr "叠加层中使用的文字大小。"

#. (itstool) path: option/_short
msgid "Background color"
msgstr "背景颜色"

#. (itstool) path: option/_long
msgid "Background color for overlay text."
msgstr "叠加层文字的背景颜色。"

#. (itstool) path: option/_short
msgid "Text color"
msgstr "文字颜色"

#. (itstool) path: option/_long
msgid "Text color for overlay."
msgstr "叠加层文字的颜色。"
