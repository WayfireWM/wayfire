#. (itstool) path: plugin/_short
msgid "Switcher"
msgstr "切换器"

#. (itstool) path: plugin/_long
msgid "A plugin to change active window with an animation."
msgstr "通过动画切换活动窗口的插件。"

#. (itstool) path: option/_short
msgid "Next view"
msgstr "下一个窗口"

#. (itstool) path: option/_long
msgid "Switches to the next view with the specified key."
msgstr "使用指定按键切换到下一个窗口。"

#. (itstool) path: option/_short
msgid "Previous view"
msgstr "上一个窗口"

#. (itstool) path: option/_long
msgid "Switches to the previous view with the specified key."
msgstr "使用指定按键切换到上一个窗口。"

#. (itstool) path: option/_short
msgid "Duration"
msgstr "持续时间"

#. (itstool) path: option/_long
msgid "Sets the duration of the animation in milliseconds."
msgstr "设置动画持续时间（毫秒）。"

#. (itstool) path: option/_short
msgid "Thumbnail size"
msgstr "缩略图大小"

#. (itstool) path: option/_long
msgid "Sets the thumbnail size."
msgstr "设置缩略图大小。"

#. (itstool) path: option/_short
msgid "Thumbnail rotation"
msgstr "缩略图旋转"

#. (itstool) path: option/_long
msgid "Sets the thumbnail rotation in degrees."
msgstr "设置缩略图旋转角度（度）。"
