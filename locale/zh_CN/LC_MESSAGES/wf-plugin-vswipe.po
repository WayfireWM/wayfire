#. (itstool) path: plugin/_short
msgid "Viewport Swipe"
msgstr "视口滑动"

#. (itstool) path: plugin/_long
msgid "A plugin to swipe workspaces in a grid."
msgstr "在网格中滑动切换工作区的插件。"

#. (itstool) path: option/_short
msgid "Enable horizontal"
msgstr "启用水平滑动"

#. (itstool) path: option/_long
msgid "Enables or disables horizontal swiping."
msgstr "启用或禁用水平滑动。"

#. (itstool) path: option/_short
msgid "Enable vertical"
msgstr "启用垂直滑动"

#. (itstool) path: option/_long
msgid "Enables or disables vertical swiping."
msgstr "启用或禁用垂直滑动。"

#. (itstool) path: option/_short
msgid "Enable free movement"
msgstr "启用自由移动"

#. (itstool) path: option/_long
msgid ""
"Enables or disables moving diagonally and more than one workspace at a time."
msgstr "启用或禁用斜向移动以及一次移动多个工作区。"

#. (itstool) path: option/_short
msgid "Enable smooth transition"
msgstr "启用平滑过渡"

#. (itstool) path: option/_long
msgid "Enables or disables smooth transition."
msgstr "启用或禁用平滑过渡。"

#. (itstool) path: option/_short
msgid "Duration"
msgstr "持续时间"

#. (itstool) path: option/_long
msgid "Sets the duration of the animation in milliseconds."
msgstr "设置动画持续时间（毫秒）。"

#. (itstool) path: option/_short
msgid "Background color"
msgstr "背景颜色"

#. (itstool) path: option/_long
msgid "Sets the background color."
msgstr "设置背景颜色。"

#. (itstool) path: option/_short
msgid "Number of fingers"
msgstr "手指数"

#. (itstool) path: option/_long
msgid "Specifies the number of fingers to swipe."
msgstr "指定滑动使用的手指数。"

#. (itstool) path: option/_short
msgid "Gap"
msgstr "间隙"

#. (itstool) path: option/_long
msgid "Changes the gap in pixels."
msgstr "更改间隙大小（像素）。"

#. (itstool) path: option/_short
msgid "threshold"
msgstr "阈值"

#. (itstool) path: option/_long
msgid "Sets the threshold."
msgstr "设置阈值。"

#. (itstool) path: option/_short
msgid "Delta threshold"
msgstr "增量阈值"

#. (itstool) path: option/_long
msgid "Sets the delta threshold."
msgstr "设置增量阈值。"

#. (itstool) path: option/_short
msgid "Speed factor"
msgstr "速度系数"

#. (itstool) path: option/_long
msgid "Sets the speed factor."
msgstr "设置速度系数。"

#. (itstool) path: option/_short
msgid "Speed cap"
msgstr "速度上限"

#. (itstool) path: option/_long
msgid "Sets the speed cap."
msgstr "设置速度上限。"
