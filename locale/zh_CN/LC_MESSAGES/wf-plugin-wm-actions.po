#. (itstool) path: plugin/_short
msgid "WM Actions"
msgstr "窗口管理操作"

#. (itstool) path: plugin/_long
msgid "A plugin which provides various window management functionalities."
msgstr "提供多种窗口管理功能的插件。"

#. (itstool) path: option/_short
msgid "Toggle Always on Top"
msgstr "切换始终置顶"

#. (itstool) path: option/_long
msgid "Toggle the always-on-top state of a view."
msgstr "切换窗口的始终置顶状态。"

#. (itstool) path: option/_short
msgid "Toggle Fullscreen"
msgstr "切换全屏"

#. (itstool) path: option/_long
msgid "Toggle the fullscreen state of a view."
msgstr "切换窗口的全屏状态。"

#. (itstool) path: option/_short
msgid "Toggle Sticky"
msgstr "切换粘性"

#. (itstool) path: option/_long
msgid "Toggle the sticky state of a view."
msgstr "切换窗口的粘性状态。"

#. (itstool) path: option/_short
msgid "Toggle Maximize"
msgstr "切换最大化"

#. (itstool) path: option/_long
msgid "Toggle the maximize state of the active view."
msgstr "切换活动窗口的最大化状态。"

#. (itstool) path: option/_short
msgid "Minimize View"
msgstr "最小化窗口"

#. (itstool) path: option/_long
msgid "Minimize the active view."
msgstr "最小化活动窗口。"

#. (itstool) path: option/_short
msgid "Toggle Show Desktop"
msgstr "切换显示桌面"

#. (itstool) path: option/_long
msgid "Show the desktop."
msgstr "显示桌面。"

#. (itstool) path: option/_short
msgid "Send to back"
msgstr "置于底层"

#. (itstool) path: option/_long
msgid "Send the active view to behind all other views."
msgstr "将活动窗口置于所有其他窗口之后。"
