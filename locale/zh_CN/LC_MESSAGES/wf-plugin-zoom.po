#. (itstool) path: plugin/_short
msgid "Zoom"
msgstr "桌面缩放"

#. (itstool) path: plugin/_long
msgid "A plugin to zoom in the desktop with the mouse."
msgstr "使用鼠标缩放桌面的插件。"

#. (itstool) path: option/_short
msgid "Zoom in the desktop by scrolling with modifier"
msgstr "按住修饰键滚动以缩放桌面"

#. (itstool) path: option/_long
msgid "Scrolls with the specified modifier to zoom in and out."
msgstr "按住指定修饰键滚动以放大或缩小。"

#. (itstool) path: option/_short
msgid "Speed"
msgstr "速度"

#. (itstool) path: option/_long
msgid "Sets the speed factor for zooming."
msgstr "设置桌面缩放的速度系数。"

#. (itstool) path: option/_short
msgid "Smoothing duration"
msgstr "平滑持续时间"

#. (itstool) path: option/_long
msgid "Sets the smoothing duration in milliseconds."
msgstr "设置平滑持续时间（毫秒）。"

#. (itstool) path: option/_short
msgid "Interpolation method"
msgstr "插值方法"

#. (itstool) path: option/_long
msgid "Sets the pixel interpolation method to use."
msgstr "设置使用的像素插值方法。"

#. (itstool) path: desc/_name
msgid "Linear"
msgstr "线性"

#. (itstool) path: desc/_name
msgid "Nearest"
msgstr "最近邻"
