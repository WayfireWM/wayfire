<?xml version="1.0"?>
<wayfire>
  <object name="output">
    <category>General</category>
    <option name="mode" type="output::mode">
      <default>auto</default>
    </option>
    <option name="position" type="output::position">
      <default>auto</default>
    </option>
    <option name="scale" type="double">
      <default>1.0</default>
      <min>0.1</min>
    </option>
    <option name="transform" type="string">
      <default>normal</default>
    </option>
    <option name="min_render_budget" type="int">
      <_short>Minimum render deadline budget</_short>
      <_long>Minimum time reserved for compositor rendering before the next presentation, in milliseconds. Set to -1 to use the deprecated core/max_render_time value or disable delayed repaint if the legacy option is also unset.</_long>
      <default>-1</default>
      <min>-1</min>
    </option>
    <option name="vrr" type="bool">
      <default>false</default>
    </option>
    <option name="vrr_idle_refresh_rate" type="int">
      <_short>VRR idle refresh rate</_short>
      <_long>Minimum refresh rate maintained while a VRR output is idle. Zero disables idle refresh commits.</_long>
      <default>0</default>
      <min>0</min>
      <max>1000</max>
    </option>
    <option name="hdr" type="bool">
      <default>false</default>
    </option>
    <option name="depth" type="int">
      <default>8</default>
      <min>8</min>
      <max>10</max>
    </option>
    <option name="icc_profile" type="string">
      <default></default>
    </option>
  </object>
</wayfire>
